<span class=3D"hljs-keyword" style=3D"color: rgb(86,156,214);">public</span=
> <span class=3D"hljs-keyword" style=3D"color: rgb(86,156,214);">abstract</=
span> <span class=3D"hljs-keyword" style=3D"color: rgb(86,156,214);">class<=
/span> <span class=3D"hljs-title class_" style=3D"color: rgb(220,220,220);"=
>AbstractIdGraphRestClient</span> <span class=3D"hljs-keyword" style=3D"col=
or: rgb(86,156,214);">implements</span> <span class=3D"hljs-title class_" s=
tyle=3D"color: rgb(220,220,220);">RestApiClient</span> {

    <span class=3D"hljs-keyword" style=3D"color: rgb(86,156,214);">private<=
/span> <span class=3D"hljs-keyword" style=3D"color: rgb(86,156,214);">volat=
ile</span> RestTemplate restTemplate;
    <span class=3D"hljs-keyword" style=3D"color: rgb(86,156,214);">private<=
/span> <span class=3D"hljs-keyword" style=3D"color: rgb(86,156,214);">final=
</span> RestTemplateBeanFactory restTemplateFactory;
    <span class=3D"hljs-keyword" style=3D"color: rgb(86,156,214);">private<=
/span> <span class=3D"hljs-keyword" style=3D"color: rgb(86,156,214);">final=
</span> OutboundRestClientBuilder outboundRestClientBuilder; <span class=3D=
"hljs-comment" style=3D"color: rgb(87,166,74);">// optional</span>
