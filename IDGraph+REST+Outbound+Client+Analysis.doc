<thead class=3D"">
<tr class=3D"">
<th style=3D"text-align: left;" class=3D"confluenceTh">MS / Library</th>
<th style=3D"text-align: left;" class=3D"confluenceTh">Client</th>
<th style=3D"text-align: left;" class=3D"confluenceTh"><code>connectTimeout=
</code></th>
<th style=3D"text-align: left;" class=3D"confluenceTh"><code>readTimeout</c=
ode></th>
<th style=3D"text-align: left;" class=3D"confluenceTh">Source</th>
<th style=3D"text-align: left;" class=3D"confluenceTh">Dynamic Refresh</th>
</tr>
</thead>
<tbody class=3D"">
<tr class=3D"">
<td class=3D"confluenceTd"><strong>MPSAdapterMs</strong></td>
<td class=3D"confluenceTd">All 21 clients</td>
<td class=3D"confluenceTd">Per-API via Azure App Config</td>
<td class=3D"confluenceTd">Per-API via Azure App Config</td>
<td class=3D"confluenceTd"><code>IDGraphAzureAppConfig</code></td>
<td class=3D"confluenceTd">=E2=9C=85 Yes</td>
</tr>
<tr class=3D"">
