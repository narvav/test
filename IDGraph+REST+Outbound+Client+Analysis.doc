<td class=3D"confluenceTd">10000</td>
<td class=3D"confluenceTd"><code>application.properties</code></td>
<td class=3D"confluenceTd">=E2=9C=85 Yes</td>
</tr>
<tr class=3D"">
<td class=3D"confluenceTd"><strong>ExtClientHelpers</strong></td>
<td class=3D"confluenceTd"><code>BbnmsClientHelper</code></td>
<td class=3D"confluenceTd">5000</td>
<td class=3D"confluenceTd">10000</td>
<td class=3D"confluenceTd"><code>application.properties</code></td>
<td class=3D"confluenceTd">=E2=9C=85 Yes</td>
</tr>
<tr class=3D"">
<td class=3D"confluenceTd"><strong>ExtClientHelpers</strong></td>
<td class=3D"confluenceTd"><code>McafeeClientHelper</code></td>
<td class=3D"confluenceTd">5000</td>
<td class=3D"confluenceTd">10000</td>
<td class=3D"confluenceTd"><code>application.properties</code></td>
<td class=3D"confluenceTd">=E2=9C=85 Yes</td>
