<h3 class=3D"code-line" style=3D"" data-line=3D"466" id=3D"IDGraphRESTOutbo=
undClientAnalysis-CorrespondingProperties">Corresponding Properties</h3>
<pre><code class=3D"code-line language-properties" data-line=3D"468"><span =
class=3D"hljs-comment" style=3D"color: rgb(87,166,74);"># Per-client timeou=
t (consumed by RestTemplateBeanFactory)</span>
<span class=3D"hljs-attr" style=3D"color: rgb(156,220,254);">apiclient.rest=
.subsvcms.connectTimeout</span>=3D<span class=3D"hljs-string" style=3D"colo=
r: rgb(214,157,133);">5000</span>
<span class=3D"hljs-attr" style=3D"color: rgb(156,220,254);">apiclient.rest=
.subsvcms.readTimeout</span>=3D<span class=3D"hljs-string" style=3D"color: =
rgb(214,157,133);">10000</span>
<span class=3D"hljs-attr" style=3D"color: rgb(156,220,254);">apiclient.rest=
.subsvcms.logging.enabled</span>=3D<span class=3D"hljs-string" style=3D"col=
or: rgb(214,157,133);">true</span>
<span class=3D"hljs-attr" style=3D"color: rgb(156,220,254);">apiclient.rest=
.subsvcms.logging.bodyEnabled</span>=3D<span class=3D"hljs-string" style=3D=
"color: rgb(214,157,133);">true</span>
<span class=3D"hljs-comment" style=3D"color: rgb(87,166,74);">
# Retry config</span>
<span class=3D"hljs-attr" style=3D"color: rgb(156,220,254);">apiclient.rest=
.subsvcms.retry.maxAttempts</span>=3D<span class=3D"hljs-string" style=3D"c=
olor: rgb(214,157,133);">3</span>
<span class=3D"hljs-attr" style=3D"color: rgb(156,220,254);">apiclient.rest=
.subsvcms.retry.backoffDelay</span>=3D<span class=3D"hljs-string" style=3D"=
color: rgb(214,157,133);">500</span>
<span class=3D"hljs-attr" style=3D"color: rgb(156,220,254);">apiclient.rest=
.subsvcms.retry.multiplier</span>=3D<span class=3D"hljs-string" style=3D"co=
lor: rgb(214,157,133);">2.0</span>
</code></pre>
<h3 class=3D"code-line" style=3D"" data-line=3D"481" id=3D"IDGraphRESTOutbo=
undClientAnalysis-RetryBeanConfiguration">Retry Bean Configuration</h3>
<pre><code class=3D"code-line language-java" data-line=3D"483"><span class=
=3D"hljs-meta" style=3D"color: rgb(155,155,155);">@Configuration</span>
<span class=3D"hljs-keyword" style=3D"color: rgb(86,156,214);">public</span=
> <span class=3D"hljs-keyword" style=3D"color: rgb(86,156,214);">class</spa=
n> <span class=3D"hljs-title class_" style=3D"color: rgb(220,220,220);">Res=
tClientRetryConfig</span> {

    <span class=3D"hljs-meta" style=3D"color: rgb(155,155,155);">@Bean("sub=
svcRetryTemplate")</span>
    <span class=3D"hljs-keyword" style=3D"color: rgb(86,156,214);">public</=
span> RetryTemplate <span class=3D"hljs-title function_" style=3D"color: rg=
b(220,220,220);">subsvcRetryTemplate</span><span class=3D"hljs-params" styl=
e=3D"color: rgb(220,220,220);">(
            <span class=3D"hljs-meta" style=3D"color: rgb(155,155,155);">@V=
alue("${apiclient.rest.subsvcms.retry.maxAttempts:3}")</span> <span class=
=3D"hljs-type" style=3D"color: rgb(78,201,176);">int</span> maxAttempts,
            <span class=3D"hljs-meta" style=3D"color: rgb(155,155,155);">@V=
alue("${apiclient.rest.subsvcms.retry.backoffDelay:500}")</span> <span clas=
s=3D"hljs-type" style=3D"color: rgb(78,201,176);">long</span> delay,
            <span class=3D"hljs-meta" style=3D"color: rgb(155,155,155);">@V=
alue("${apiclient.rest.subsvcms.retry.multiplier:2.0}")</span> <span class=
=3D"hljs-type" style=3D"color: rgb(78,201,176);">double</span> multiplier)<=
/span> {
        <span class=3D"hljs-keyword" style=3D"color: rgb(86,156,214);">retu=
rn</span> RetryTemplate.builder()
                .maxAttempts(maxAttempts)
                .exponentialBackoff(delay, multiplier, delay * (<span class=
=3D"hljs-type" style=3D"color: rgb(78,201,176);">long</span>) Math.pow(mult=
iplier, maxAttempts))
                .retryOn(HttpServerErrorException.class)
                .retryOn(ResourceAccessException.class)
                .build();
    }
}
</code></pre>
<h3 class=3D"code-line" style=3D"" data-line=3D"502" id=3D"IDGraphRESTOutbo=
undClientAnalysis-BenefitsofThisPattern">Benefits of This Pattern</h3>
<div class=3D"table-wrap">
<table style=3D"" class=3D"confluenceTable">
<thead class=3D"">
<tr class=3D"">
<th style=3D"text-align: left;" class=3D"confluenceTh">Benefit</th>
<th style=3D"text-align: left;" class=3D"confluenceTh">Before</th>
<th style=3D"text-align: left;" class=3D"confluenceTh">After</th>
</tr>
</thead>
<tbody class=3D"">
<tr class=3D"">
<td class=3D"confluenceTd"><strong>TLS/SSL</strong></td>
<td class=3D"confluenceTd">Missing for direct<span>&nbsp;</span><code>RestT=
emplate</code><span>&nbsp;</span>clients</td>
<td class=3D"confluenceTd">Always via<span>&nbsp;</span><code>RestTemplateB=
eanFactory</code></td>
</tr>
<tr class=3D"">
<td class=3D"confluenceTd"><strong>Timeouts</strong></td>
<td class=3D"confluenceTd">Global default for most</td>
<td class=3D"confluenceTd">Per-client configurable</td>
</tr>
<tr class=3D"">
<td class=3D"confluenceTd"><strong>Retry</strong></td>
<td class=3D"confluenceTd">Inconsistent (annotation / manual / none)</td>
<td class=3D"confluenceTd">Uniform<span>&nbsp;</span><code>RetryTemplate</c=
ode></td>
</tr>
<tr class=3D"">
<td class=3D"confluenceTd"><strong>Error handling</strong></td>
<td class=3D"confluenceTd">Varied per client</td>
<td class=3D"confluenceTd">Centralized in base class</td>
</tr>
<tr class=3D"">
<td class=3D"confluenceTd"><strong>SPI logging</strong></td>
<td class=3D"confluenceTd">Some use EXT000/EXT999, some don't</td>
<td class=3D"confluenceTd">Always via base class</td>
</tr>
<tr class=3D"">
<td class=3D"confluenceTd"><strong>Dynamic refresh</strong></td>
<td class=3D"confluenceTd">Only in 3 clients</td>
<td class=3D"confluenceTd">Built into base class</td>
</tr>
<tr class=3D"">
<td class=3D"confluenceTd"><strong>Header population</strong></td>
<td class=3D"confluenceTd">Duplicated in every client</td>
<td class=3D"confluenceTd">Shared via<span>&nbsp;</span><code>buildHeaders(=
)</code></td>
</tr>
<tr class=3D"">
<td class=3D"confluenceTd"><strong>Connection pool</strong></td>
<td class=3D"confluenceTd">Shared across APIs</td>
<td class=3D"confluenceTd">Isolated per client name</td>
</tr>
<tr class=3D"">
<td class=3D"confluenceTd"><strong>Testability</strong></td>
<td class=3D"confluenceTd">Hard to mock =E2=80=94 inline RestTemplate</td>
<td class=3D"confluenceTd">Mock<span>&nbsp;</span><code>RestTemplateBeanFac=
tory</code></td>
</tr>
</tbody>
</table>
</div>
