/span> <span class=3D"hljs-keyword" style=3D"color: rgb(86,156,214);">final=
</span> RetryTemplate retryTemplate;

    <span class=3D"hljs-comment" style=3D"color: rgb(87,166,74);">// =E2=94=
=80=E2=94=80 Subclass provides =E2=94=80=E2=94=80</span>
    <span class=3D"hljs-keyword" style=3D"color: rgb(86,156,214);">protecte=
d</span> <span class=3D"hljs-keyword" style=3D"color: rgb(86,156,214);">abs=
tract</span> String <span class=3D"hljs-title function_" style=3D"color: rg=
b(220,220,220);">getClientName</span><span class=3D"hljs-params" style=3D"c=
olor: rgb(220,220,220);">()</span>;        <span class=3D"hljs-comment" sty=
le=3D"color: rgb(87,166,74);">// factory key</span>
    <span class=3D"hljs-keyword" style=3D"color: rgb(86,156,214);">protecte=
d</span> <span class=3D"hljs-keyword" style=3D"color: rgb(86,156,214);">abs=
tract</span> String <span class=3D"hljs-title function_" style=3D"color: rg=
b(220,220,220);">getBaseUrl</span><span class=3D"hljs-params" style=3D"colo=
r: rgb(220,220,220);">()</span>;            <span class=3D"hljs-comment" st=
yle=3D"color: rgb(87,166,74);">// @Value injected</span>
    <span class=3D"hljs-keyword" style=3D"color: rgb(86,156,214);">protecte=
d</span> <span class=3D"hljs-keyword" style=3D"color: rgb(86,156,214);">abs=
tract</span> String <span class=3D"hljs-title function_" style=3D"color: rg=
b(220,220,220);">getClientId</span><span class=3D"hljs-params" style=3D"col=
or: rgb(220,220,220);">()</span>;           <span class=3D"hljs-comment" st=
yle=3D"color: rgb(87,166,74);">// @Value injected</span>
    <span class=3D"hljs-keyword" style=3D"color: rgb(86,156,214);">protecte=
d</span> <span class=3D"hljs-keyword" style=3D"color: rgb(86,156,214);">abs=
tract</span> String <span class=3D"hljs-title function_" style=3D"color: rg=
b(220,220,220);">getClientSecret</span><span class=3D"hljs-params" style=3D=
"color: rgb(220,220,220);">()</span>;       <span class=3D"hljs-comment" st=
yle=3D"color: rgb(87,166,74);">// @Value injected</span>

    <span class=3D"hljs-keyword" style=3D"color: rgb(86,156,214);">protecte=
d</span> <span class=3D"hljs-title function_" style=3D"color: rgb(220,220,2=
20);">AbstractIdGraphRestClient</span><span class=3D"hljs-params" style=3D"=
color: rgb(220,220,220);">(
            RestTemplateBeanFactory factory,
            OutboundRestClientBuilder builder,   // nullable
            RetryTemplate retryTemplate)</span> <span class=3D"hljs-keyword=
" style=3D"color: rgb(86,156,214);">throws</span> Exception {
        <span class=3D"hljs-built_in" style=3D"color: rgb(78,201,176);">thi=
s</span>.restTemplateFactory =3D factory;
        <span class=3D"hljs-built_in" style=3D"color: rgb(78,201,176);">thi=
s</span>.outboundRestClientBuilder =3D builder;
        <span class=3D"hljs-built_in" style=3D"color: rgb(78,201,176);">thi=
s</span>.retryTemplate =3D retryTemplate;
        <span class=3D"hljs-built_in" style=3D"color: rgb(78,201,176);">thi=
s</span>.restTemplate =3D factory.getObject(getClientName());
    }

    <span class=3D"hljs-comment" style=3D"color: rgb(87,166,74);">// =E2=94=
=80=E2=94=80 Core HTTP call with retry + SPI logging =E2=94=80=E2=94=80</sp=
an>
    <span class=3D"hljs-keyword" style=3D"color: rgb(86,156,214);">protecte=
d</span> &lt;T&gt; ResponseEntity&lt;T&gt; <span class=3D"hljs-title functi=
on_" style=3D"color: rgb(220,220,220);">executeWithRetry</span><span class=
=3D"hljs-params" style=3D"color: rgb(220,220,220);">(
            String path, HttpMethod method,
            Object requestBody, Class&lt;T&gt; responseType,
            String traceId, String callingSystemId)</span> {

        <span class=3D"hljs-keyword" style=3D"color: rgb(86,156,214);">retu=
rn</span> retryTemplate.execute(context -&gt; {
            <span class=3D"hljs-type" style=3D"color: rgb(78,201,176);">Str=
ing</span> <span class=3D"hljs-variable" style=3D"color: rgb(189,99,197);">=
url</span> <span class=3D"hljs-operator">=3D</span> getBaseUrl() + path;
            <span class=3D"hljs-type" style=3D"color: rgb(78,201,176);">Htt=
pHeaders</span> <span class=3D"hljs-variable" style=3D"color: rgb(189,99,19=
7);">headers</span> <span class=3D"hljs-operator">=3D</span> buildHeaders(t=
raceId, callingSystemId);
            HttpEntity&lt;?&gt; entity =3D <span class=3D"hljs-keyword" sty=
le=3D"color: rgb(86,156,214);">new</span> <span class=3D"hljs-title class_"=
 style=3D"color: rgb(220,220,220);">HttpEntity</span>&lt;&gt;(requestBody, =
headers);

            log.info(SpiMarker.getInstance(), <span class=3D"hljs-string" s=
tyle=3D"color: rgb(214,157,133);">"EXT000: {} {} request to {}"</span>,
                    getClientName(), method, url);
            <span class=3D"hljs-type" style=3D"color: rgb(78,201,176);">lon=
g</span> <span class=3D"hljs-variable" style=3D"color: rgb(189,99,197);">st=
art</span> <span class=3D"hljs-operator">=3D</span> System.currentTimeMilli=
s();

            ResponseEntity&lt;T&gt; response =3D restTemplate.exchange(
                    url, method, entity, responseType);

            log.info(<span class=3D"hljs-string" style=3D"color: rgb(214,15=
7,133);">"EXT999: {} response in {}ms, status=3D{}"</span>,
                    getClientName(), System.currentTimeMillis() - start,
                    response.getStatusCode());
            <span class=3D"hljs-keyword" style=3D"color: rgb(86,156,214);">=
return</span> response;
        });
    }

    <span class=3D"hljs-comment" style=3D"color: rgb(87,166,74);">// =E2=94=
=80=E2=94=80 Standard header population =E2=94=80=E2=94=80</span>
    <span class=3D"hljs-keyword" style=3D"color: rgb(86,156,214);">private<=
/span> HttpHeaders <span class=3D"hljs-title function_" style=3D"color: rgb=
(220,220,220);">buildHeaders</span><span class=3D"hljs-params" style=3D"col=
or: rgb(220,220,220);">(String traceId, String callingSystemId)</span> {
        <span class=3D"hljs-type" style=3D"color: rgb(78,201,176);">HttpHea=
ders</span> <span class=3D"hljs-variable" style=3D"color: rgb(189,99,197);"=
>headers</span> <span class=3D"hljs-operator">=3D</span> <span class=3D"hlj=
s-keyword" style=3D"color: rgb(86,156,214);">new</span> <span class=3D"hljs=
-title class_" style=3D"color: rgb(220,220,220);">HttpHeaders</span>();
        headers.setContentType(MediaType.APPLICATION_JSON);
        headers.add(<span class=3D"hljs-string" style=3D"color: rgb(214,157=
,133);">"Authorization"</span>, <span class=3D"hljs-string" style=3D"color:=
 rgb(214,157,133);">"Basic "</span> +
                Base64.getEncoder().encodeToString(
                    (getClientId() + <span class=3D"hljs-string" style=3D"c=
olor: rgb(214,157,133);">":"</span> + getClientSecret()).getBytes()));
        headers.add(<span class=3D"hljs-string" style=3D"color: rgb(214,157=
,133);">"idp-trace-id"</span>, traceId);
        headers.add(<span class=3D"hljs-string" style=3D"color: rgb(214,157=
,133);">"X-ATT-ClientId"</span>, callingSystemId);
        <span class=3D"hljs-keyword" style=3D"color: rgb(86,156,214);">retu=
rn</span> headers;
    }

    <span class=3D"hljs-comment" style=3D"color: rgb(87,166,74);">// =E2=94=
=80=E2=94=80 Dynamic refresh handler =E2=94=80=E2=94=80</span>
    <span class=3D"hljs-meta" style=3D"color: rgb(155,155,155);">@EventList=
ener(RefreshScopeRefreshedEvent.class)</span>
    <span class=3D"hljs-keyword" style=3D"color: rgb(86,156,214);">public</=
span> <span class=3D"hljs-keyword" style=3D"color: rgb(86,156,214);">synchr=
onized</span> <span class=3D"hljs-keyword" style=3D"color: rgb(86,156,214);=
">void</span> <span class=3D"hljs-title function_" style=3D"color: rgb(220,=
220,220);">onRefresh</span><span class=3D"hljs-params" style=3D"color: rgb(=
220,220,220);">()</span> {
        <span class=3D"hljs-keyword" style=3D"color: rgb(86,156,214);">try<=
/span> {
            <span class=3D"hljs-type" style=3D"color: rgb(78,201,176);">Res=
tTemplate</span> <span class=3D"hljs-variable" style=3D"color: rgb(189,99,1=
97);">updated</span> <span class=3D"hljs-operator">=3D</span> outboundRestC=
lientBuilder !=3D <span class=3D"hljs-literal" style=3D"color: rgb(86,156,2=
14);">null</span>
                    ? outboundRestClientBuilder.buildRefreshedRestTemplate(
                          restTemplateFactory, getClientName())
                    : restTemplateFactory.getObject(getClientName());
            <span class=3D"hljs-built_in" style=3D"color: rgb(78,201,176);"=
>this</span>.restTemplate =3D updated;
            log.info(<span class=3D"hljs-string" style=3D"color: rgb(214,15=
7,133);">"{} RestTemplate refreshed with new timeouts"</span>, getClientNam=
e());
        } <span class=3D"hljs-keyword" style=3D"color: rgb(86,156,214);">ca=
tch</span> (Exception e) {
            log.error(<span class=3D"hljs-string" style=3D"color: rgb(214,1=
57,133);">"{} RestTemplate refresh failed, retaining existing instance"</sp=
an>,
                    getClientName(), e);
        }
    }
}
</code></pre>
